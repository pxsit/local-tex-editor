{
  "name": "latex-editor",
  "version": "1.0.1",
  "private": true,
  "description": "Local single-project Overleaf-style LaTeX editor",
  "main": "server.js",
  "scripts": {
    "build": "node build.js",
    "start": "node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
