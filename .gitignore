# dependencies
/node_modules/

# runtime / local state (created on first run)
server.log
*.log
settings.json
.build/

# the user's LaTeX project and its compile output stay local
/contents/*

# build artifacts that are not needed to run (the bundles in public/ stay committed)
*.map

# env / secrets
.env
.env.*

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# npm debug
npm-debug.log*
.npm/

# temp files from atomic saves
*.tmp-*
